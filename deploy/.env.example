# Copy to deploy/.env and fill in local values. NEVER commit the real .env.
# .env is gitignored; only this .example file is tracked.

# --- Postgres ---
POSTGRES_USER=blood
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=blooddb

# --- App ---
APP_ENV=development
HTTP_ADDR=:8080

# Connection string used by the API, goose, and sqlc tooling.
# Use host "localhost" when running tools from your machine; compose overrides
# the API container to use host "db".
DATABASE_URL=postgres://blood:change-me-locally@localhost:5432/blooddb?sslmode=disable
