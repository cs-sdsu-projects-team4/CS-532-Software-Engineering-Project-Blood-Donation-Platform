# Copy to deploy/.env and fill in local values. NEVER commit the real .env.
# .env is gitignored; only this .example file is tracked.

# --- Postgres ---
POSTGRES_USER=blood
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=blooddb

# --- App ---
APP_ENV=development
HTTP_ADDR=:8080

# --- Auth (JWT) ---
# Secret used to sign access/refresh tokens. REQUIRED. Generate a long random
# value locally (e.g. `openssl rand -hex 32`); never commit the real secret.
JWT_SECRET=change-me-to-a-long-random-value
JWT_ISSUER=blood-donation-api
# Go duration strings. Access tokens are short-lived; refresh tokens longer.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Bootstrap admin (optional) ---
# On startup the API ensures a system_admin with this email exists (idempotent).
# Set BOTH to create the first admin on a fresh database (clinics/staff are only
# provisioned by a system_admin). Leave blank to skip. Never commit a real value.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Connection string used by the API, goose, and sqlc tooling.
# Use host "localhost" when running tools from your machine; compose overrides
# the API container to use host "db".
DATABASE_URL=postgres://blood:change-me-locally@localhost:5432/blooddb?sslmode=disable
